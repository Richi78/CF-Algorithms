	\section{Extended Euclidean Algorithm}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		int gcd(int a, int b, int &x, int &y){
			if(b==0){
				x=1; y=0;
				return a;
			}
			int x1,y1;
			int g=gcd(b, a%b, x1, y1);
			x = y1;
			y = x1 - y1 * (a / b);
			return g;
		}
	\end{lstlisting}
	
	\section{Catalan number}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		vector<int> dp;
		const int MOD=998244353;
		
		void catalan(int n){ // from 1 to n
			dp.resize(n+1);
			dp[0]=dp[1]=1;
			for(int i=2 ; i<=n ; i++){
				for(int j=0 ; j<i ; j++){
					dp[i]=(dp[i]+(dp[j]*dp[i-j-1])%MOD)%MOD;
				}
			}
		}
		
		int catalan(int n){
			int ans=1;
			for(int i=0 ; i<n ; i++){
				ans=ans*2*(2*i+1)/(i+2);
			}
			return ans;
		}

		// ===== AI added: Catalan formula (LL) =====
		// ai: integer division is exact at every step because i+2 always divides
		//     the current numerator; use this when n is small and you want to avoid the DP array.
		long long catalanLL(int n){
			long long ans = 1;
			for(int i=0 ; i<n ; i++){
				ans = ans * 2 * (2*i+1) / (i+2);
			}
			return ans;
		}
	\end{lstlisting}
	
	\section{LPS + KMP}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		vector<int> create_lps(string &needle){
			int n=(int)needle.size();
			vector<int> lps(n);
			int i=1 , prevLPS=0;
			while(i < n){
				if(needle[i] == needle[prevLPS]){
					lps[i]=prevLPS+1;
					i++; prevLPS++;
				}else if(prevLPS == 0){
					lps[i]=0; i++;
				}else{
					prevLPS=lps[prevLPS-1];
				}
			}
			return lps; 
		}
		
		void solve(){
			string s,p; cin >> s >> p;
			
			int sz_text=(int)s.size() , sz_pattern=(int)p.size();
			vector<int> lps=create_lps(p);
			int cnt=0;
			int i=0; // ptr text
			int j=0; // ptr pattern
			while(i<sz_text){
				if(s[i] == p[j]){
					i++; j++;
				}else if(j == 0) i++;
				else j=lps[j-1];
				if(j == sz_pattern){
					cnt++;
					j=lps[j-1];
				}
			}
			cout<< cnt <<"\n";
		}
	\end{lstlisting}
	
	\section{Rolling Hash}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct pair_hash {
			size_t operator()(const pair<int,int>& p) const {
				return ((uint64_t)p.first << 32) ^ (uint64_t)p.second;
			}
		};
		struct H{
			vector<pair<int,int>> h,p;
			const int MOD1=998244353;
			const int MOD2=1e9+7;
			const int A=31;
			string s;
			H(string &a){
				s=a;
				int n=s.size();
				h.resize(n+1); p.resize(n+1,{1,1});
				for(int i=1 ; i<=n ; i++){
					h[i].F=((h[i-1].F*A)%MOD1 + s[i-1])%MOD1;
					h[i].S=((h[i-1].S*A)%MOD2 + s[i-1])%MOD2;
					p[i].F=(p[i-1].F*A)%MOD1;
					p[i].S=(p[i-1].S*A)%MOD2;
				}
			}
			pair<int,int> getHash(int l, int r){
				pair<int,int> ans;
				ans.F=(h[r].F-(h[l-1].F*p[r-l+1].F)%MOD1)%MOD1;
				ans.S=(h[r].S-(h[l-1].S*p[r-l+1].S)%MOD2)%MOD2;
				ans.F=(ans.F+MOD1)%MOD1;
				ans.S=(ans.S+MOD2)%MOD2;
				return ans;
			}
		};
		// unordered_set<pair<int,int>, pair_hash> st;
	\end{lstlisting}
	
	\section{Dijkstra}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		vector<int> dijkstra(int n, vector<vector<int>> adj[], int s){
			set<array<int,2>> st;
			vector<int> dist(n,1e18);
			dist[s]=0;
			st.insert({0,s});
			while(!st.empty()){
				auto it=*st.begin();
				int dis=it[0] , node=it[1];
				st.erase(it);
				for(auto [adjN,adjW] : adj[node]){
					if(dis+adjW < dist[adjN]){
						if(dist[adjN] != 1e18){
							st.erase({dist[adjN],adjN});
						}
						dist[adjN]=dis+adjW;
						st.insert({dist[adjN],adjN});
					}
				}
			}
			return dist;
		}
	\end{lstlisting}
	
	\section{Bellman ford}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		vector<int> ford(int n, vector<array<int,3>> edges, int s){
			// u v w
			vector<int> dist(n,1e18);
			dist[s]=0;
			for(int i=0 ; i<n-1 ; i++){ // n-1 relaxations
				for(auto x : edges){
					int u=x[0] , v=x[1] , w=x[2];
					if(dist[u] != 1e18 && dist[u]+w < dist[v]){
						dist[v]=dist[u]+w;
					}
				}
			}
			// detect negative cycle one more relaxation
			//for(auto x : edges){
				//int u=x[0] , v=x[1] , w=x[2];
				//if(dist[u] != 1e18 && dist[u]+w < dist[v]){
					// there is a negative cycle
					//}
				//}
			return dist;
		}
	\end{lstlisting}
	
	\section{Floyd Warshall}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		vector<vector<int>> floyd(int n, vector<vector<int>> adj[]){
			vector<vector<int>> ans(n,vector<int>(n,1e18));
			for(int i=0 ; i<n ; i++) ans[i][i]=0;
			for(int i=0 ; i<n ; i++){
				for(auto x : adj[i]){
					int adjN=x[0] , adjW=x[1];
					ans[i][adjN]=adjW;
					ans[adjN][i]=adjW;
				}
			}
			
			for(int via=0 ; via<n ; via++){
				for(int i=0 ; i<n ; i++){
					for(int j=0 ; j<n ; j++){
						ans[i][j]=min(ans[i][j] , 
						ans[i][via]+ans[via][j]);
					}
				}
			}
			
			// Detect negative cycle: if any ans[i][i] < 0 after the algorithm,
			// then there is a negative cycle reachable from i.
			//for(int i=0 ; i<n ; i++){
				//if(ans[i][i] < 0){
					// negative cycle reachable from source i
					//}
				//}
			return ans;
		}
	\end{lstlisting}
	
	\section{DSU}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		class DisjointSet{
			vector<int> parent, size;
			public:
			DisjointSet(int n){
				parent.resize(n+1);
				size.resize(n+1);
				for(int i=0 ; i<=n ; i++){
					parent[i]=i;
					size[i]=1;
				}
			}
			int findUPar(int node){
				if(node == parent[node]) return node;
				return parent[node]=findUPar(parent[node]);
			}
			void UnionBySize(int u, int v){
				int ulp_u=findUPar(u);
				int ulp_v=findUPar(v);
				if(ulp_u == ulp_v) return;
				if(size[ulp_u] < size[ulp_v]){
					parent[ulp_u]=ulp_v;
					size[ulp_v]+=size[ulp_u];
				}else{
					parent[ulp_v]=ulp_u;
					size[ulp_u]+=size[ulp_v];
				}
			}
		};
	\end{lstlisting}
	
	\section{Kosaraju}

	% ai: original used `vector<...> adj[n]` which is a VLA (non-standard C++).
	%     The code below is kept as reference. For a portable template, see the
	%     rewritten version with parameterized adjacency in PLAN_01.
	\begin{lstlisting}[style=mystyle, language=C++]
		void dfs(int node, vector<pair<int,int>> adj[], vector<bool> &vis,
		stack<int> &st){
			vis[node]=1;
			for(auto [adjN,adjW] : adj[node]){
				if(!vis[adjN]){
					dfs(adjN , adj , vis , st);
				}
			}
			st.push(node);
		}
		
		void dfs2(int node, vector<pair<int,int>> adj[], vector<bool> &vis, 
		vector<int> &scc, int scc_number){
			vis[node]=1;
			scc[node]=scc_number;
			for(auto [adjN,adjW] : adj[node]){
				if(!vis[adjN]){
					dfs2(adjN , adj , vis , scc , scc_number);
				}
			}
		}
		
		void solve(){
			int n,m; cin >> n >> m;
			vector< pair<int,int> > adj[n];
			for(int i=0 ; i<m ; i++){
				int u,v,w; cin >> u >> v >> w;
				u--; v--;
				adj[u].emplace_back(v,w);
			}
			
			vector<bool> vis(n);
			stack<int> st;
			for(int i=0 ; i<n ; i++){
				if(!vis[i]){
					dfs(i , adj , vis , st);
				}
			}
			
			vector<pair<int,int>> adjT[n];
			for(int i=0 ; i<n ; i++){
				vis[i]=0;
				for(auto [adjN,adjW] : adj[i]){
					adjT[adjN].push_back({i,adjW});
				}
			}
			
			vector<int> scc(n);
			int scc_number=0;
			while(!st.empty()){
				int node=st.top();
				st.pop();
				if(!vis[node]){
					scc_number++;
					dfs2(node, adjT, vis, scc, scc_number);
				}
			}
			
			vector<pair<int,int>> adjCond[scc_number];
			for(int i=0 ; i<n ; i++){
				for(auto [adjN,adjW] : adj[i]){
					if(scc[i] != scc[adjN]){
						adjCond[scc[i]-1].emplace_back(scc[adjN]-1,adjW);
					}
				}
			}
		}
	\end{lstlisting}
	
	\section{Tarjan}
	Critical connections
	\begin{lstlisting}[style=mystyle, language=C++]
		void dfs(int node, int parent, vector<int> adj[], vector<int> &time,
		vector<int> &low, vector<array<int,2>> &ans, int &t){
			time[node] = low[node] = t;
			t++;
			for(auto adjN : adj[node]){
				if(adjN == parent) continue;
				if(!time[adjN]){
					dfs(adjN, node, adj, time, low, ans, t);
					low[node]=min(low[node],low[adjN]);
					if(time[node] < low[adjN]){
						int mn=min(node,adjN) , mx=max(node,adjN);
						ans.push_back({mn,mx});
					}
				}else{
					low[node]=min(low[node],low[adjN]);
				}
			}
		}
		
		void solve(){
			int n,m; cin >> n >> m;
			vector<int> adj[n+1];
			for(int i=0 ; i<m ; i++){
				int u,v; cin >> u >> v;
				adj[u].push_back(v);
				adj[v].push_back(u);
			}
			
			vector<int> time(n+1) , low(n+1);
			vector<array<int,2>> ans;
			int t=1;
			dfs(1, -1, adj, time, low, ans, t);
		}
	\end{lstlisting}
	Articulation point
	\begin{lstlisting}[style=mystyle, language=C++]
		void dfs(int node, int parent, vector<int> adj[], vector<int> &tin,
		vector<int> &low, vector<bool> &artPoint, int &t){
			tin[node]=low[node]=++t;
			int child=0;
			for(auto adjN : adj[node]){
				if(adjN == parent) continue;
				if(!tin[adjN]){
					dfs(adjN, node, adj, tin, low, artPoint, t);
					low[node]=min(low[node],low[adjN]);
					if(low[adjN] >= tin[node] && parent != -1){
						artPoint[node]=true;
					}
					child++;
				}else{
					low[node]=min(low[node],tin[adjN]);
				}
			}
			if(child>1 && parent==-1) artPoint[node]=true;
		}
		
		void solve(){
			int n,m; cin >> n >> m;
			vector<int> adj[n+1];
			for(int i=0 ; i<m ; i++){
				int u,v; cin >> u >> v;
				adj[u].push_back(v);
				adj[v].push_back(u);
			}
			
			vector<int> tin(n+1) , low(n+1);
			vector<bool> artPoint(n+1);
			int t=0;
			for(int i=1 ; i<=n ; i++){
				if(tin[i] == 0){
					dfs(i , -1 , adj , tin , low , artPoint, t);
				}
			}
		}
	\end{lstlisting}
	
	\section{Suffix Array}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct SuffArr{
			vector<int> p,c;
			int n;
			string s;
			SuffArr(string &a){
				s=a;
				n=s.size();
				p.resize(n) ; c.resize(n);
				build();
			}
			void count_sort(vector<int> &p, vector<int> &c){
				int n=p.size();
				vector<int> cnt(n);
				for(auto x : c ) cnt[x]++;
				vector<int> p_new(n) , pos(n);
				pos[0]=0;
				for(int i=1 ; i<n ; i++){
					pos[i]=pos[i-1]+cnt[i-1];
				}
				for(auto x : p){
					int i=c[x];
					p_new[pos[i]]=x;
					pos[i]++;
				}
				p=p_new;
			}
			void build(){
				{
					vector<pair<int,int>> tmp(n);
					for(int i=0 ; i<n ; i++){
						tmp[i]={s[i],i};
					}
					sort(all(tmp));
					for(int i=0 ; i<n ; i++){
						p[i]=tmp[i].S;
					}
					c[p[0]]=0;
					for(int i=1 ; i<n ; i++){
						if(tmp[i].F == tmp[i-1].F){
							c[p[i]]=c[p[i-1]];
						}else{
							c[p[i]]=c[p[i-1]]+1;
						}
					}
				}
				int k=0;
				while((1<<k) < n){
					// k -> k+1
					for(int i=0; i<n ; i++){
						p[i]=(p[i]-(1<<k) + n)%n;
					}
					
					count_sort(p,c);
					
					vector<int> c_new(n);
					c_new[p[0]]=0;
					for(int i=1 ; i<n ; i++){
						pair<int,int> prev={c[p[i-1]],c[(p[i-1]+(1<<k))%n]};
						pair<int,int> now={c[p[i]],c[(p[i]+(1<<k))%n]};
						if(now == prev){
							c_new[p[i]]=c_new[p[i-1]];
						}else{
							c_new[p[i]]=c_new[p[i-1]]+1;
						}
					}
					c=c_new;
					k++;
				}   
			}
		};
	\end{lstlisting}
	
	\section{Trie}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct Node{
			Node *links[26];
			bool flag=false;
			bool containsKey(char ch){
				return links[ch-'a'] != NULL;
			}
			void put(char ch, Node* node){
				links[ch-'a'] = node;
			}
			Node* get(char ch){
				return links[ch-'a'];
			}
			void setEnd(){
				flag=true;
			}
			bool isEnd(){
				return flag;
			}
		};
		class Trie{
			private:
			Node *root;
			public:
			Trie(){
				root = new Node();
			}
			// tc -> O(len)
			void insert(string word){
				Node* node = root;
				for(int i=0 ; i<word.size() ; i++){
					if(!node->containsKey(word[i])){
						node->put(word[i], new Node()); 
					} 
					// moves to reference trie
					node = node->get(word[i]);
				}
				node->setEnd();
			}
			// tc -> O(len)
			bool search(string word){
				Node* node = root;
				for(int i=0 ; i<word.size() ; i++){
					if(!node->containsKey(word[i])){
						return false;
					}
					node = node->get(word[i]);
				}
				return node->isEnd();
			}
			// tc -> O(len)
			bool startsWith(string prefix){
				Node* node = root;
				for(int i=0 ; i<prefix.size() ; i++){
					if(!node->containsKey(prefix[i])){
						return false;
					}
					node = node->get(prefix[i]);
				}
				return true;
			}
		};
	\end{lstlisting}
	
	\section{Basis}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct Basis{
			int d=64;
			vector<int> basis; 
			int sz=0; // current size of the basis
			Basis(){
				basis.resize(d);
			}
			void insertVector(int mask){
				for(int i=d-1 ; i>=0 ; i--){ 
					if( (mask & (1LL<<i)) == 0 ) continue; 
					if( !basis[i] ){  
						basis[i]=mask;
						++sz;
						return;
					}
					mask ^= basis[i]; 
				}
			}
		};
	\end{lstlisting}
	
	\section{MO}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct Q{
			int l,r,idx;
		};
		
		void solve(){
			...
			int rootN=sqrtl(n);
			vector<Q> q(n);
			for(int i=0 ; i<m ; i++){
				int l,r; cin >> l >> r;
				q[i].l=l-1;
				q[i].r=r-1;
				q[i].idx=i;
			}
			sort(all(q), [&](Q x, Q y){
				if(x.l/rootN == y.l/rootN){
					return x.r > y.r;
				}
				return x.l/rootN < y.l/rootN;
			});
			int l=0 , r=-1;
			vector<int> ans(m);
			for(int i=0 ; i<m ; i++){
				int query_l=q[i].l;
				int query_r=q[i].r;
				while(r < query_r){
					r++; 
					// add
				}
				while(r > query_r){
					// delete
					r--;
				}
				while(l < query_l){
					// delete
					l++;
				}
				while(l > query_l){
					l--;
					// add
				}
				ans[q[i].idx]= // rpta
			}
		}
	\end{lstlisting}
	
	\section{Hopcroft-Karp}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		struct HopcroftKarp {
			int n, m; // n->#left_nodes  m->#right_nodes
			vector<vector<int>> adj; 
			vector<int> dist, matchU, matchV;
			
			HopcroftKarp(int n, int m): n(n), m(m) {
				adj.assign(n + 1, {});
				matchU.assign(n + 1, 0);
				matchV.assign(m + 1, 0);
				dist.assign(n + 1, 0);
			}
			
			void addEdge(int u, int v) {
				adj[u].push_back(v);
			}
			
			bool bfs() {
				queue<int> q;
				for (int u = 1; u <= n; u++) {
					if (matchU[u] == 0) {
						dist[u] = 0;
						q.push(u);
					} else {
						dist[u] = -1;
					}
				}
				bool found = false;
				while (!q.empty()) {
					int u = q.front(); q.pop();
					for (int v : adj[u]) {
						if (matchV[v] != 0 && dist[matchV[v]] == -1) {
							dist[matchV[v]] = dist[u] + 1;
							q.push(matchV[v]);
						}
						if (matchV[v] == 0) {
							found = true;
						}
					}
				}
				return found;
			}
			
			bool dfs(int u) {
				for (int v : adj[u]) {
					if (matchV[v] == 0 || 
					(dist[matchV[v]] == dist[u] + 1 && dfs(matchV[v]))) {
						matchU[u] = v;
						matchV[v] = u;
						return true;
					}
				}
				dist[u] = -1;
				return false;
			}
			
			int maxMatching() {
				int matching = 0;
				while (bfs()) {
					for (int u = 1; u <= n; u++) {
						if (matchU[u] == 0 && dfs(u)) {
							matching++;
						}
					}
				}
				return matching;
			}
		};
	\end{lstlisting}
	
	\section{Kuhn}
	
	\begin{lstlisting}[style=mystyle, language=C++]
		bool try_match(int u, vector<int> adj[],
		vector<int>& matchR, vector<bool>& vis) {
			for (int v : adj[u]) {
				if (vis[v]) continue;
				vis[v] = true;
				if (matchR[v] == -1 || try_match(matchR[v], adj, matchR, vis)) {
					matchR[v] = u;
					return true;
				}
			}
			return false;
		}
		
		void solve(){
			// freopen("censor.in", "r", stdin);
			// freopen("censor.out", "w", stdout);
			vector<int> adj[n+1];
			
			vector<int> matchR(n + 1, -1);
			int matching = 0;
			for (int u = 1; u <= n; u++) {
				vector<bool> vis(n + 1, false);
				if (try_match(u, adj, matchR, vis)) {
					matching++;
				}
			}
			
			// matching == n example
		}
	\end{lstlisting}
	
